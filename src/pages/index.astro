---
import "../styles/global.css";
import Header from "../components/header/Header.tsx";
import Home from "../components/Home.tsx"
import LeftBanner from "../components/side-banners/LeftBanner.tsx";
import RightBanner from "../components/side-banners/RightBanner.tsx";
import AboutMe from "../components/about-me/AboutMe";
import Experience from "../components/experience/Experience"
import Projects from "../components/projects/Projects";
import Other from "../components/other-projects/Other";
import Contact from "../components/contact/Contact";
---

<html>
  <body class="text-text-primary font-inter">
    <div class="relative overflow-x-hidden min-h-screen">
      <Header />
      <LeftBanner/>
      <RightBanner/>
      <Home/>
      <AboutMe/>
      <Experience client:load/>
      <Projects client:load/>
      <Other/>
      <Contact>
    </div>
  </body>
</html>